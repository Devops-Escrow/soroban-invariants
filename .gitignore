# Generated by Cargo
# will have compiled files and executables
/target/
/test_snapshots/

# These are also much more likely to be discarded than checkin
**/*.rs.bk

# Cargo.lock is tracked for this library crate to guarantee reproducible CI builds and dependency audits,
# but if you need to ignore local backup files:
*.orig

# Editor and OS files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Temporary scratch and environment files
.env
.env.*
*.log
